# Neon Postgres (pooled connection string)
DATABASE_URL=
# Clerk (production instance for sheetpress.org)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Public site URL, used for share links
NEXT_PUBLIC_APP_URL=https://sheetpress.org
# Optional: shown on the legal pages
NEXT_PUBLIC_SUPPORT_EMAIL=
REPORT_DOMAINS="reports.example.com=my-report-abc123"

# Self-service custom domains (Vercel REST API). Leave unset to keep the feature off.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Landing page switch, set to 1 after testing a real domain end to end
NEXT_PUBLIC_CUSTOM_DOMAINS=

# SEO and analytics (all optional)
# Search Console / Bing Webmaster meta-tag verification (the DNS TXT method needs no variable)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Set to 1 to count visits on the public marketing pages (also enable Analytics on the Vercel project)
NEXT_PUBLIC_ANALYTICS=
# Google tag: a Tag Manager container (GTM-XXXXXXX) or GA4 Measurement ID (G-XXXXXXXXXX); "off" disables.
# Loads only after a visitor accepts, on public pages only. Defaults to the SheetPress container.
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Analytics consent: regional (default; on by default except EU/EEA/UK/CH, which get an opt-in banner) | none (on for everyone) | optin (off until accepted)
NEXT_PUBLIC_CONSENT_MODE=regional
